{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "quirrel",
      "camelcase": "Quirrel",
      "title": "Quirrel",
      "scope": "source.quirrel",
      "path": ".",
      "file-types": [
        "nut"
      ],
      "injection-regex": "^(quirrel|nut)$",
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Dagor Quirrel grammar for tree-sitter",
    "authors": [
      {
        "name": "Gaijin Entertainment"
      },
      {
        "name": "Anton Zinovyev",
        "email": "xog3@yandex.ru"
      }
    ],
    "links": {
      "repository": "https://github.com/GaijinEntertainment/tree-sitter-quirrel"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
